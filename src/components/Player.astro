---
const { kind, src, slow } = Astro.props;
---
<div class="player" data-slow={slow ? JSON.stringify(slow) : undefined}>
  {kind === 'video'
    ? <video class="video" playsinline preload="auto" src={src}></video>
    : <audio preload="auto" src={src}></audio>}
  <div class="controls">
    <button type="button" class="pp" aria-label="Play" data-state="paused"></button>
    <input type="range" class="seek" min="0" max="1000" value="0" step="1" aria-label="Seek" />
    <span class="time">0:00 / 0:00</span>
    <span class="speed" role="group" aria-label="Playback speed">
      <button type="button" data-spd="-1" aria-label="Slower">–</button>
      <span class="time sv">1×</span>
      <button type="button" data-spd="1" aria-label="Faster">+</button>
    </span>
    {kind === 'video' && <span class="speed dly" role="group" aria-label="Audio delay calibration" title="Video delay, for Bluetooth audio: raise until picture and sound line up" hidden>
      <button type="button" data-dly="-1" aria-label="Less delay">–</button>
      <span class="time sv dv">0 ms</span>
      <button type="button" data-dly="1" aria-label="More delay">+</button>
    </span>}
    {kind === 'video' && <button type="button" class="fs" aria-label="Fullscreen"></button>}
  </div>
  <slot />
</div>

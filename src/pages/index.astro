---
import Layout from '../layouts/Layout.astro';
import { getPieces } from '../lib/pieces.js';
const pieces = getPieces();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tags = [...new Set(pieces.flatMap((p) => p.tags))].sort();
const sets = new Map();
for (const p of pieces) {
  const k = p.set || '';
  if (!sets.has(k)) sets.set(k, []);
  sets.get(k).push(p);
}
const groups = [...sets.entries()]
  .map(([name, items]) => ({ name, items: items.sort((a, b) => a.setOrder - b.setOrder || a.title.localeCompare(b.title)) }))
  .sort((a, b) => (a.name ? 0 : 1) - (b.name ? 0 : 1) || a.name.localeCompare(b.name));
---
<Layout title="Choir Practice">
  <h1>Choir Practice</h1>
  <input type="search" data-search style="width:100%;box-sizing:border-box;margin:4px 0" placeholder="Search title, composer, set…" aria-label="Search pieces" />
  {tags.length > 0 && (
    <nav class="tabs" aria-label="Filter by tag">
      <button data-filter="" aria-selected="true">All</button>
      {tags.map((t) => <button data-filter={t} aria-selected="false">{t}</button>)}
    </nav>
  )}
  {groups.map((g) => (
    <section data-group>
      {g.name && <h2>{g.name}</h2>}
      <ul class="list">
        {g.items.map((p) => (
          <li data-tags={JSON.stringify(p.tags)} data-title={p.title} data-composer={p.composer} data-set={p.set}>
            <a href={`${base}/pieces/${p.slug}/`}>{p.title}</a><br />
            <small>{[p.composer, ...p.tags].filter(Boolean).join(' · ')}</small>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Layout>
<script>
  let tag = '';
  const input = document.querySelector('[data-search]') as HTMLInputElement | null;
  const apply = () => {
    const q = (input?.value || '').trim().toLowerCase();
    document.querySelectorAll('li[data-tags]').forEach((li) => {
      const el = li as HTMLElement;
      const tags = JSON.parse(el.dataset.tags!);
      const hay = [el.dataset.title, el.dataset.composer, el.dataset.set].join(' ').toLowerCase();
      el.hidden = (!!tag && !tags.includes(tag)) || (!!q && !hay.includes(q));
    });
    document.querySelectorAll('[data-group]').forEach((g) => {
      (g as HTMLElement).hidden = ![...g.querySelectorAll('li')].some((li) => !li.hidden);
    });
  };
  document.querySelectorAll('[data-filter]').forEach((b) => b.addEventListener('click', () => {
    tag = (b as HTMLElement).dataset.filter || '';
    document.querySelectorAll('[data-filter]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    apply();
  }));
  input?.addEventListener('input', apply);
</script>

---
import Layout from '../../layouts/Layout.astro';
import Player from '../../components/Player.astro';
import { getPieces } from '../../lib/pieces.js';
export function getStaticPaths() {
  return getPieces().map((p) => ({ params: { slug: p.slug }, props: { piece: p } }));
}
const { piece } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const synced = !!piece.tracks[0].video;
const mixParts = piece.tracks.filter((x, j) => j > 0 && x.audio);
// Neighbours within the piece's set, in the same order the home page lists them.
const sibs = piece.set
  ? getPieces().filter((p) => p.set === piece.set).sort((a, b) => a.setOrder - b.setOrder || a.title.localeCompare(b.title))
  : [];
const si = sibs.findIndex((p) => p.slug === piece.slug);
const prev = sibs[si - 1];
const next = sibs[si + 1];
// Scores are always US Letter, so the layout doesn't need to wait for the PDF to load.
const pa = piece.tracks.some((t) => t.pdf) ? 8.5 / 11 : null;
const file = (f) => `${base}/pieces/${piece.slug}/${f}`;
const slowOf = (t) => (t.slow ? JSON.stringify(Object.fromEntries(Object.entries(t.slow).map(([k, v]) => [k, file(v)]))) : undefined);
---
<Layout title={piece.title} wide>
  {pa && <script is:inline define:vars={{ pa }}>document.documentElement.style.setProperty('--pa', pa); window.__paSet = true;</script>}
  <div class="titlebar">
    <h1>{piece.title}{piece.composer && ` - ${piece.composer}`}</h1>
    <a class="btn" href={`${base}/`}>◄ All pieces</a>
  </div>
  {piece.set && (
    <div class="setbar">
      <span class="sn" title={piece.set}>{piece.set}</span>
      <span class="sc">{si + 1} of {sibs.length}</span>
      {prev ? <a class="btn" href={`${base}/pieces/${prev.slug}/`} title={`Previous: ${prev.title}`}>◄ Prev</a> : <button type="button" class="btn" disabled>◄ Prev</button>}
      {next ? <a class="btn" href={`${base}/pieces/${next.slug}/`} title={`Next: ${next.title}`}>Next ►</a> : <button type="button" class="btn" disabled>Next ►</button>}
    </div>
  )}
  {!synced && <nav class="tabs" role="tablist" >
    {piece.tracks.map((t, i) => (
      <button role="tab" data-tab={t.key} data-audio={t.audio ? file(t.audio) : undefined} data-slow={slowOf(t)} data-video={t.video || undefined} data-name={`${piece.slug}-${t.key}.mp3`} aria-selected={i === 0 ? 'true' : 'false'}>{t.label}</button>
    ))}
  </nav>}
  {piece.tracks.filter((_, i) => !synced || i === 0).map((t, i) => (
    <section class="cols" data-panel={t.key} hidden={i !== 0}>
      <div class="media">
      {!synced && t.audio && (
        <section class="box">
          <h2><span>Audio</span><button type="button" class="min" aria-label="Minimize Audio" aria-expanded="true"></button></h2>
          <div class="body">
          <Player kind="audio" src={file(t.audio)} slow={t.slow && Object.fromEntries(Object.entries(t.slow).map(([k, v]) => [k, file(v)]))} />
          <p class="actions">
            <a class="btn" href={file(t.audio)} download={`${piece.slug}-${t.key}.mp3`}>Download audio</a>
          </p>
          </div>
        </section>
      )}
      {synced && i === 0 && (
        <section class="box">
          <h2><span>Video</span><button type="button" class="min" aria-label="Minimize Video" aria-expanded="true"></button></h2>
          <div class="body">
          <Player kind="video" src={t.video}>
            <nav class="tabs" role="tablist" data-synced>
              {piece.tracks.map((x, j) => (
                <button type="button" role="tab" data-tab={x.key} data-audio={x.audio ? file(x.audio) : undefined} data-slow={slowOf(x)} data-video={x.video || undefined} data-name={`${piece.slug}-${x.key}.mp3`} aria-selected={j === 0 ? 'true' : 'false'}>{x.label}</button>
              ))}
              {mixParts.length > 1 && <button type="button" role="tab" data-tab="custom" aria-selected="false">Custom</button>}
            </nav>
            {mixParts.length > 1 && (
              <div class="mixer" data-open="1" hidden>
                <button type="button" class="mxopen" aria-label="Restore mixer" title="Restore Custom Mix"></button>
                <div class="mxpanel" role="group" aria-label="Custom mix">
                  <div class="mxbar"><span>Custom Mix</span><button type="button" class="mxclose" aria-label="Minimize mixer" title="Minimize"></button></div>
                  <div class="mxrows">
                    {mixParts.map((x) => (
                      <div class="mrow" data-k={x.key}>
                        <div class="vs"><input type="range" class="mv" min="0" max="100" value="75" aria-orientation="vertical" aria-label={`${x.label} volume`} /></div>
                        <label><input type="checkbox" checked /><span>{x.label}</span></label>
                      </div>
                    ))}
                  </div>
                  <div class="mxfoot"><button type="button" class="mxreset" title="Set every part back to 75%">Reset</button></div>
                </div>
              </div>
            )}
          </Player>
          <p class="actions">
            <a class="btn" id="dl-video" href={t.video} target="_blank" rel="noopener">Download video</a>
            <a class="btn" id="dl-audio" href={file(t.audio)} download={`${piece.slug}-${t.key}.mp3`}>Download audio</a>
          </p>
          </div>
        </section>
      )}
      {!synced && t.video && (
        <section class="box">
          <h2><span>Video</span><button type="button" class="min" aria-label="Minimize Video" aria-expanded="true"></button></h2>
          <div class="body">
          <Player kind="video" src={t.video} />
          <p class="actions">
            <a class="btn" href={t.video} target="_blank" rel="noopener">Download video</a>
          </p>
          </div>
        </section>
      )}
      </div>
      {t.pdf && (
        <section class="box score">
          <h2><span>Score PDF</span><button type="button" class="min" aria-label="Minimize Score PDF" aria-expanded="true"></button></h2>
          <div class="body">
          <div class="pdfview" data-src={file(t.pdf)}>
            <div class="bar">
              <button type="button" data-act="prev" aria-label="Previous page">◄</button>
              <button type="button" data-act="next" aria-label="Next page">►</button>
              <span class="pg">Page – / –</span>
              <button type="button" data-act="out" aria-label="Zoom out">–</button>
              <button type="button" data-act="in" aria-label="Zoom in">+</button>
              <button type="button" data-act="fit">Fit</button>
              <button type="button" class="fs" data-act="fs" aria-label="Fullscreen"></button>
            </div>
            <div class="pages" tabindex="0" aria-label={`${t.label} score`}></div>
            <div class="loading" role="progressbar" aria-label="Loading score"><span class="lt">Loading score… 0%</span><div class="track"><i></i></div></div>
            <p class="fallback">Can't see the score? Use the buttons below to open or download it.</p>
          </div>
          <p class="actions">
            <a class="btn" href={file(t.pdf)} target="_blank" rel="noopener">Open in new tab</a>
            <a class="btn" href={file(t.pdf)} download>Download PDF</a>
          </p>
          </div>
        </section>
      )}
    </section>
  ))}
</Layout>
<script>
  import '../../scripts/pdfview.js';
  document.addEventListener('click', (e) => {
    const b = e.target.closest?.('.min');
    if (!b) return;
    const body = b.closest('.box').querySelector('.body');
    body.hidden = !body.hidden;
    b.setAttribute('aria-expanded', String(!body.hidden));
  });
  const fmt = (s) => {
    if (!isFinite(s)) s = 0;
    return `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
  };
  document.querySelectorAll('.player').forEach((p) => {
    const m = p.querySelector('audio, video');
    const pp = p.querySelector('.pp');
    const seek = p.querySelector('.seek');
    const time = p.querySelector('.time');
    let dragging = false;
    const paint = () => {
      if (!dragging) seek.value = m.duration ? (m.currentTime / m.duration) * 1000 : 0;
      seek.style.setProperty('--p', `${seek.value / 10}%`);
      time.textContent = `${fmt(dragging ? (seek.value / 1000) * m.duration : m.currentTime)} / ${fmt(m.duration)}`;
    };
    const state = () => {
      const playing = !m.paused;
      pp.dataset.state = playing ? 'playing' : 'paused';
      pp.setAttribute('aria-label', playing ? 'Pause' : 'Play');
    };
    const toggle = () => (m.paused ? m.play().catch(() => {}) : m.pause());
    pp.addEventListener('click', toggle);
    if (m.tagName === 'VIDEO') m.addEventListener('click', toggle);
    p.querySelector('.fs')?.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else if (p.requestFullscreen) p.requestFullscreen().catch(() => {});
      else m.webkitEnterFullscreen?.();
    });
    seek.addEventListener('input', () => {
      dragging = true;
      if (m.duration) m.currentTime = (seek.value / 1000) * m.duration;
      paint();
    });
    seek.addEventListener('change', () => { dragging = false; paint(); });
    // Audio with pre-rendered slow copies swaps files instead of stretching in the browser.
    const SPEEDS = [0.75, 0.875, 1];
    const slow = p.dataset.slow ? JSON.parse(p.dataset.slow) : null;
    const orig = m.getAttribute('src');
    const sv = p.querySelector('.sv');
    const sb = p.querySelectorAll('[data-spd]');
    let sp = 1;
    m.preservesPitch = true;
    const stretch = (s) => (m.tagName === 'AUDIO' && slow?.[s] ? s : 1);
    const shown = () => {
      const i = SPEEDS.indexOf(sp);
      sv.textContent = `${sp}×`;
      sb[0].disabled = i === 0;
      sb[1].disabled = i === SPEEDS.length - 1;
    };
    p.speed = () => sp;
    p.setSpeed = (s) => {
      if (s === sp) return;
      const old = sp;
      sp = s;
      shown();
      if (m.tagName === 'VIDEO') { if (p.onSpeed) p.onSpeed(s); else m.playbackRate = s; return; }
      const t = (m.currentTime * stretch(old)) / stretch(s);
      const playing = !m.paused;
      const url = (s !== 1 && slow?.[s]) || orig;
      if (m.getAttribute('src') !== url) {
        m.src = url;
        m.addEventListener('loadedmetadata', () => {
          m.currentTime = t;
          if (playing) m.play().catch(() => {});
        }, { once: true });
      }
      m.defaultPlaybackRate = m.playbackRate = s / stretch(s);
    };
    sb.forEach((b) => b.addEventListener('click', () => {
      const i = SPEEDS.indexOf(sp);
      p.setSpeed(SPEEDS[Math.max(0, Math.min(SPEEDS.length - 1, i + Number(b.dataset.spd)))]);
    }));
    shown();
    ['timeupdate', 'loadedmetadata', 'durationchange', 'seeked'].forEach((e) => m.addEventListener(e, paint));
    ['play', 'pause', 'ended'].forEach((e) => m.addEventListener(e, state));
  });
  // Desktop mode: the score fills the window height, the video column matches it,
  // and the body is as wide as that needs. If it won't fit the width, fall back to one column.
  const root = document.documentElement;
  let lastPh = 0;
  // fit() briefly tries desktop mode, which can shrink the page and clamp the scroll position,
  // so put the scroll position back afterwards (matters on phones, where it runs mid-scroll).
  const fit = () => {
    const y = scrollY;
    measure();
    if (scrollY !== y) scrollTo(0, y);
  };
  const measure = () => {
    const c = document.querySelector('.cols:not([hidden])');
    if (!c) return;
    const v = c.querySelector('.video');
    const score = c.querySelector('.score');
    const pages = c.querySelector('.pages');
    const media = c.querySelector('.media');
    const mobile = () => {
      root.classList.remove('desk');
      document.querySelectorAll('.video').forEach((e) => { e.style.height = ''; });
    };
    if (!score) return mobile();
    root.classList.add('desk');
    document.querySelectorAll('.box > .body').forEach((e) => { e.hidden = false; });
    document.querySelectorAll('.min').forEach((e) => e.setAttribute('aria-expanded', 'true'));
    document.querySelectorAll('.video').forEach((e) => { e.style.height = ''; });
    if (v) v.style.height = '240px';
    let ph = lastPh;
    if (pages.offsetHeight) {
      root.style.setProperty('--ph', '480px');
      const total = document.body.getBoundingClientRect().bottom + scrollY + 12;
      ph = Math.floor(innerHeight - (total - pages.offsetHeight));
      lastPh = ph;
    }
    if (ph < 380) return mobile();
    const apply = () => {
      root.style.setProperty('--ph', `${ph}px`);
      let h = '';
      if (v && pages.offsetHeight) {
        const other = media.offsetHeight - v.offsetHeight;
        const cs = getComputedStyle(score);
        const outer = score.offsetHeight + parseFloat(cs.marginTop) + parseFloat(cs.marginBottom);
        h = `${Math.max(200, outer - other)}px`;
      }
      document.querySelectorAll('.video').forEach((e) => { e.style.height = h; });
    };
    apply();
    const excess = root.scrollHeight - innerHeight;
    if (excess > 0 && pages.offsetHeight) {
      ph -= excess;
      lastPh = ph;
      if (ph < 380) return mobile();
      apply();
    }
    const need = media.getBoundingClientRect().width + 16 + score.getBoundingClientRect().width + 18;
    if (need > innerWidth - 24) mobile();
  };
  // Only recalculate when the change can matter: any size change in desktop mode, but just
  // width in one-column mode. Phone address bars resize the height while you scroll.
  let lw = innerWidth;
  let lh = innerHeight;
  addEventListener('resize', () => {
    const desk = root.classList.contains('desk');
    const need = innerWidth !== lw || (desk && innerHeight !== lh);
    lw = innerWidth;
    lh = innerHeight;
    if (need) fit();
  });
  const reveal = () => root.classList.remove('pre');
  addEventListener('refit', () => { fit(); reveal(); });
  fit();
  if (!document.querySelector('.score') || window.__paSet) reveal();
  else setTimeout(reveal, 2500);
  const tabs = document.querySelectorAll('[data-tab]');
  const panels = document.querySelectorAll('[data-panel]');
  // Audio syncs with audio and video with video, never across kinds.
  const media = (p, kind) => p?.querySelector(kind);
  const handOff = (from, to) => {
    if (!from || !to) return;
    const t = from.currentTime;
    const play = !from.paused;
    from.pause();
    to.closest('.player')?.setSpeed?.(from.closest('.player')?.speed?.() ?? 1);
    const go = () => {
      to.currentTime = t;
      if (play) to.play().catch(() => {});
    };
    if (to.readyState >= 1) go();
    else {
      to.addEventListener('loadedmetadata', go, { once: true });
      to.load();
    }
  };
  // Every tab shows the same score, so keep one viewer and move it into the visible panel.
  const score = document.querySelector('.score');
  document.querySelectorAll('.score').forEach((e) => { if (e !== score) e.remove(); });
  // Synced mode: one muted video drives silent-until-selected MP3s, so switching tabs
  // only changes which one is unmuted (no seeking, no reloading).
  const synced = document.querySelector('nav.tabs[data-synced]');
  let setActive = () => {};
  let applyMix = () => {};
  // The chosen part (or Custom mix) is remembered for the browser session, so the next piece opens the same way.
  let mixState = {};
  try { mixState = JSON.parse(sessionStorage.getItem('cpmix')) || {}; } catch {}
  mixState = { sel: mixState.sel || '', vols: mixState.vols || {}, on: mixState.on || {} };
  const DEFVOL = 0.75;
  const saveMix = () => { try { sessionStorage.setItem('cpmix', JSON.stringify(mixState)); } catch {} };
  const dlVideo = document.getElementById('dl-video');
  const dlAudio = document.getElementById('dl-audio');
  if (synced) {
    const v = document.querySelector('.player video');
    const vp = v.closest('.player');
    const urls = {};
    tabs.forEach((t) => {
      if (t.dataset.audio) urls[t.dataset.tab] = { 1: t.dataset.audio, ...(t.dataset.slow ? JSON.parse(t.dataset.slow) : {}) };
    });
    const keys = Object.keys(urls);
    let active = tabs[0].dataset.tab;
    // Which parts sound, and how loud: one part at full volume, or the Custom mix.
    const wantMix = () => {
      const o = {};
      if (active === 'custom') {
        keys.filter((k) => k !== 'full').forEach((k) => {
          const g = mixState.on[k] === false ? 0 : (mixState.vols[k] ?? DEFVOL);
          if (g > 0) o[k] = g;
        });
      } else if (urls[active]) o[active] = 1;
      return o;
    };
    const wantKeys = () => [...new Set([...Object.keys(wantMix()), ...keys])];
    let ctx = null;
    try { ctx = new AudioContext(); } catch {}
    // Parts are decoded into memory and played as Web Audio buffer sources on the audio clock:
    // no <audio> elements, no seeking, sample-accurate sync. The video follows that clock.
    // Without Web Audio, fall back to the video's own (full choir) sound.
    if (!ctx) v.muted = false;
    else {
      v.muted = true;
      if (navigator.audioSession) navigator.audioSession.type = 'playback';
      const TAU = 0.04;
      // Debug recorder (turn on with ?debug, off with ?debug=0): a timestamped event and
      // sample log with a button to copy it, so a bad session can be inspected afterwards.
      if (location.search.includes('debug=0')) sessionStorage.removeItem('cpdebug');
      else if (location.search.includes('debug')) sessionStorage.setItem('cpdebug', '1');
      const debug = sessionStorage.getItem('cpdebug') === '1';
      const T0 = performance.now();
      const logs = [];
      const log = (...a) => {
        if (!debug) return;
        logs.push(`${((performance.now() - T0) / 1000).toFixed(2)} ${a.join(' ')}`);
        if (logs.length > 8000) logs.shift();
      };
      log('page', navigator.userAgent, 'ctx', ctx.sampleRate, 'base', ctx.baseLatency, 'out', ctx.outputLatency, 'ts', typeof ctx.getOutputTimestamp);
      const master = ctx.createGain();
      master.connect(ctx.destination);
      const unlock = () => {
        if (ctx.state === 'running') return;
        ctx.resume();
        const s = ctx.createBufferSource();
        s.buffer = ctx.createBuffer(1, 1, ctx.sampleRate);
        s.connect(ctx.destination);
        s.start();
      };
      ['pointerdown', 'touchend', 'click', 'keydown'].forEach((e) => document.addEventListener(e, unlock, { capture: true, passive: true }));
      // Slowed parts are pre-rendered files, so their clock runs `f` times the music's.
      const info = (sp, k) => {
        const u = urls[k];
        return sp !== 1 && u[sp] ? { url: u[sp], f: sp, rate: 1 } : { url: u[1], f: 1, rate: sp };
      };
      // Downmix in small slices so it never blocks the page (and the video) for long.
      const mono = async (b) => {
        if (b.numberOfChannels === 1) return b;
        const o = ctx.createBuffer(1, b.length, b.sampleRate);
        const d = o.getChannelData(0);
        const n = b.numberOfChannels;
        for (let c = 0; c < n; c++) {
          const x = b.getChannelData(c);
          for (let i = 0; i < x.length; i += 200000) {
            const end = Math.min(x.length, i + 200000);
            for (let j = i; j < end; j++) d[j] += x[j] / n;
            await new Promise((r) => setTimeout(r));
          }
        }
        return o;
      };
      // Parts are streamed: each compressed MP3 is kept in memory with a frame index, and only
      // short windows around the playhead are decoded. Memory stays small however long the piece
      // is, and tab switches are instant because every part's current window is already decoded.
      const BR = [0, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320];
      const RATES = [44100, 48000, 32000];
      const WIN = 20;
      const OV = 0.06;
      const PRE = 3;
      const parse = (ab) => {
        const u = new Uint8Array(ab);
        let o = 0;
        if (u[0] === 0x49 && u[1] === 0x44 && u[2] === 0x33) o = 10 + (((u[6] & 127) << 21) | ((u[7] & 127) << 14) | ((u[8] & 127) << 7) | (u[9] & 127));
        const fr = [];
        let rate = 32000;
        // An encoder info frame (Xing/Info, written by ffmpeg/LAME) isn't audio: skip it, and use
        // its encoder delay so times line up with how a whole-file decode trims the start.
        let skip = -1;
        let delay = 0;
        let pad = 0;
        while (o + 4 <= u.length) {
          if (u[o] !== 0xff || (u[o + 1] & 0xe0) !== 0xe0 || ((u[o + 1] >> 3) & 3) !== 3 || ((u[o + 1] >> 1) & 3) !== 1) { o++; continue; }
          const br = BR[u[o + 2] >> 4] * 1000;
          const s = RATES[(u[o + 2] >> 2) & 3];
          if (!br || !s) { o++; continue; }
          const len = Math.floor((144 * br) / s) + ((u[o + 2] >> 1) & 1);
          if (o + len > u.length) break;
          rate = s;
          if (skip < 0) {
            skip = 0;
            const side = ((u[o + 3] >> 6) === 3 ? 17 : 32) + 4;
            const tag = String.fromCharCode(...u.slice(o + side, o + side + 4));
            if (tag === 'Xing' || tag === 'Info') {
              const l = o + side + 120;
              delay = (u[l + 21] << 4) | (u[l + 22] >> 4);
              pad = ((u[l + 22] & 15) << 8) | u[l + 23];
              delay += 529;
              o += len;
              continue;
            }
          }
          fr.push(o);
          o += len;
        }
        fr.push(o);
        const n = fr.length - 1;
        const fd = 1152 / rate;
        const off = delay / rate;
        return { u, fr, n, fd, off, dur: n * fd - off - pad / rate };
      };
      const idx = {};
      const idxv = {};
      const index = (s, k) => {
        const id = `${s}/${k}`;
        return (idx[id] ||= fetch(info(s, k).url)
          .then((r) => { if (!r.ok) throw new Error(r.status); return r.arrayBuffer(); })
          .then((ab) => (idxv[id] = parse(ab)))
          .catch((e) => { delete idx[id]; throw e; }));
      };
      const wins = {};
      const ready = {};
      const jobs = {};
      let busy = false;
      let sp = 1;
      let tgt = 1;
      const decodeWin = async (j) => {
        const x = await index(j.s, j.k);
        const t = performance.now();
        let w;
        if (!x.n) w = { buf: await mono(await ctx.decodeAudioData(x.u.slice().buffer)), t0: 0 };
        else {
          const fa = Math.max(0, Math.floor((j.i * WIN + x.off) / x.fd) - PRE);
          const f1 = Math.min(x.n, Math.ceil(((j.i + 1) * WIN + OV + x.off) / x.fd));
          w = { buf: await mono(await ctx.decodeAudioData(x.u.slice(x.fr[fa], x.fr[f1]).buffer)), t0: fa * x.fd - x.off };
        }
        log('decoded', j.id, Math.round(performance.now() - t), 'ms');
        return w;
      };
      // One decode at a time, most urgent first.
      const pump = async () => {
        if (busy) return;
        busy = true;
        for (;;) {
          let j = null;
          Object.values(jobs).forEach((x) => { if (!x.run && (!j || x.p < j.p)) j = x; });
          if (!j) break;
          j.run = true;
          try {
            if (j.s !== sp && j.s !== tgt) throw new Error('stale');
            const w = await decodeWin(j);
            if (wins[j.id]) ready[j.id] = w;
            j.res(w);
          } catch (e) { delete wins[j.id]; j.rej(e); }
          delete jobs[j.id];
        }
        busy = false;
      };
      const win = (s, k, i, p = 1e6) => {
        const id = `${s}/${k}/${i}`;
        if (!wins[id]) {
          wins[id] = new Promise((res, rej) => { jobs[id] = { id, s, k, i, p, res, rej, run: false }; });
          wins[id].catch(() => {});

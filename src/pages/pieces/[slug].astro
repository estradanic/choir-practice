---
import Layout from '../../layouts/Layout.astro';
import { getPieces } from '../../lib/pieces.js';
export function getStaticPaths() {
  return getPieces().map((p) => ({ params: { slug: p.slug }, props: { piece: p } }));
}
const { piece } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const file = (f) => `${base}/pieces/${piece.slug}/${f}`;
---
<Layout title={piece.title}>
  <div class="titlebar">
    <h1>{piece.title}</h1>
    <a class="btn" href={`${base}/`}>◄ All pieces</a>
  </div>
  <p>{piece.composer}</p>
  <nav class="tabs" role="tablist">
    {piece.tracks.map((t, i) => (
      <button role="tab" data-tab={t.key} aria-selected={i === 0 ? 'true' : 'false'}>{t.label}</button>
    ))}
  </nav>
  {piece.tracks.map((t, i) => (
    <section data-panel={t.key} hidden={i !== 0}>
      {t.audio && (
        <section class="box">
          <h2><span>Audio</span><button type="button" class="min" aria-label="Minimize Audio" aria-expanded="true"></button></h2>
          <div class="body">
          <audio controls preload="auto" src={file(t.audio)}></audio>
          <p class="actions">
            <a class="btn" href={file(t.audio)} download={`${piece.slug}-${t.key}.mp3`}>Download audio</a>
          </p>
          </div>
        </section>
      )}
      {t.video && (
        <section class="box">
          <h2><span>Video</span><button type="button" class="min" aria-label="Minimize Video" aria-expanded="true"></button></h2>
          <div class="body">
          <video class="video" controls playsinline preload="auto" src={t.video}></video>
          <p class="actions">
            <a class="btn" href={t.video} target="_blank" rel="noopener">Download video</a>
          </p>
          </div>
        </section>
      )}
      {t.pdf && (
        <section class="box">
          <h2><span>Score PDF</span><button type="button" class="min" aria-label="Minimize Score PDF" aria-expanded="true"></button></h2>
          <div class="body">
          <object class="pdf" type="application/pdf" data={file(t.pdf)} aria-label={`${t.label} score`}>
              <p>Your browser cannot display this PDF. <a href={file(t.pdf)}>Open it instead</a>.</p>
            </object>
          <p class="actions">
            <a class="btn" href={file(t.pdf)} target="_blank" rel="noopener">Open in new tab</a>
            <a class="btn" href={file(t.pdf)} download>Download PDF</a>
          </p>
          </div>
        </section>
      )}
    </section>
  ))}
</Layout>
<script>
  document.addEventListener('click', (e) => {
    const b = e.target.closest?.('.min');
    if (!b) return;
    const body = b.closest('.box').querySelector('.body');
    body.hidden = !body.hidden;
    b.setAttribute('aria-expanded', String(!body.hidden));
  });
  const tabs = document.querySelectorAll('[data-tab]');
  const panels = document.querySelectorAll('[data-panel]');
  // Audio syncs with audio and video with video, never across kinds.
  const media = (p, kind) => p?.querySelector(kind);
  const handOff = (from, to) => {
    if (!from || !to) return;
    const t = from.currentTime;
    const play = !from.paused;
    from.pause();
    const go = () => {
      to.currentTime = t;
      if (play) to.play().catch(() => {});
    };
    if (to.readyState >= 1) go();
    else {
      to.addEventListener('loadedmetadata', go, { once: true });
      to.load();
    }
  };
  tabs.forEach((tab) => tab.addEventListener('click', () => {
    const prev = [...panels].find((p) => !p.hidden);
    const next = [...panels].find((p) => p.dataset.panel === tab.dataset.tab);
    if (!next || prev === next) return;
    tabs.forEach((x) => x.setAttribute('aria-selected', String(x === tab)));
    panels.forEach((p) => { p.hidden = p !== next; });
    ['audio', 'video'].forEach((k) => handOff(media(prev, k), media(next, k)));
  }));
</script>

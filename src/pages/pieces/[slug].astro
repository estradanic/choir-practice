---
import Layout from '../../layouts/Layout.astro';
import { getPieces } from '../../lib/pieces.js';
export function getStaticPaths() {
  return getPieces().map((p) => ({ params: { slug: p.slug }, props: { piece: p } }));
}
const { piece } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const file = (f) => `${base}/pieces/${piece.slug}/${f}`;
---
<Layout title={piece.title}>
  <p><a href={`${base}/`}>← All pieces</a></p>
  <h1>{piece.title}</h1>
  <p>{piece.composer}</p>
  <nav class="tabs" role="tablist">
    {piece.tracks.map((t, i) => (
      <button role="tab" data-tab={t.key} aria-selected={i === 0 ? 'true' : 'false'}>{t.label}</button>
    ))}
  </nav>
  {piece.tracks.map((t, i) => (
    <section data-panel={t.key} hidden={i !== 0}>
      <h2>{t.label}</h2>
      {t.audio && (
        <div>
          <audio controls preload="none" src={file(t.audio)}></audio>
          <a class="btn" href={file(t.audio)} download={`${piece.slug}-${t.key}.mp3`}>Download audio</a>
        </div>
      )}
      {t.pdf && (
        <details>
          <summary>View {t.label} score (PDF)</summary>
          <object class="pdf" type="application/pdf" data={file(t.pdf)} aria-label={`${t.label} score`}>
            <p>Your browser cannot display this PDF. <a href={file(t.pdf)}>Open it instead</a>.</p>
          </object>
          <p>
            <a class="btn" href={file(t.pdf)} target="_blank" rel="noopener">Open in new tab</a>
            <a class="btn" href={file(t.pdf)} download>Download PDF</a>
          </p>
        </details>
      )}
      {t.video && (
        <div>
          <video class="video" controls playsinline preload="metadata" src={t.video}></video>
          <a class="btn" href={t.video} target="_blank" rel="noopener">Download video</a>
        </div>
      )}
    </section>
  ))}
</Layout>
<script>
  const tabs = document.querySelectorAll('[data-tab]');
  const panels = document.querySelectorAll('[data-panel]');
  tabs.forEach((tab) => tab.addEventListener('click', () => {
    tabs.forEach((x) => x.setAttribute('aria-selected', String(x === tab)));
    panels.forEach((p) => {
      p.hidden = p.dataset.panel !== tab.dataset.tab;
      if (p.hidden) p.querySelectorAll('audio, video').forEach((a) => a.pause());
    });
  }));
</script>

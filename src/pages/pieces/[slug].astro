---
import Layout from '../../layouts/Layout.astro';
import Player from '../../components/Player.astro';
import { getPieces } from '../../lib/pieces.js';
export function getStaticPaths() {
  return getPieces().map((p) => ({ params: { slug: p.slug }, props: { piece: p } }));
}
const { piece } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const synced = !!piece.tracks[0].video;
const file = (f) => `${base}/pieces/${piece.slug}/${f}`;
---
<Layout title={piece.title} wide>
  <div class="titlebar">
    <h1>{piece.title}{piece.composer && ` - ${piece.composer}`}</h1>
    <a class="btn" href={`${base}/`}>◄ All pieces</a>
  </div>
  {!synced && <nav class="tabs" role="tablist" >
    {piece.tracks.map((t, i) => (
      <button role="tab" data-tab={t.key} data-audio={t.audio ? file(t.audio) : undefined} data-video={t.video || undefined} data-name={`${piece.slug}-${t.key}.mp3`} aria-selected={i === 0 ? 'true' : 'false'}>{t.label}</button>
    ))}
  </nav>}
  {piece.tracks.filter((_, i) => !synced || i === 0).map((t, i) => (
    <section class="cols" data-panel={t.key} hidden={i !== 0}>
      <div class="media">
      {!synced && t.audio && (
        <section class="box">
          <h2><span>Audio</span><button type="button" class="min" aria-label="Minimize Audio" aria-expanded="true"></button></h2>
          <div class="body">
          <Player kind="audio" src={file(t.audio)} />
          <p class="actions">
            <a class="btn" href={file(t.audio)} download={`${piece.slug}-${t.key}.mp3`}>Download audio</a>
          </p>
          </div>
        </section>
      )}
      {synced && i === 0 && (
        <section class="box">
          <h2><span>Video</span><button type="button" class="min" aria-label="Minimize Video" aria-expanded="true"></button></h2>
          <div class="body">
          <Player kind="video" src={t.video}>
            <nav class="tabs" role="tablist" data-synced>
              {piece.tracks.map((x, j) => (
                <button type="button" role="tab" data-tab={x.key} data-audio={x.audio ? file(x.audio) : undefined} data-video={x.video || undefined} data-name={`${piece.slug}-${x.key}.mp3`} aria-selected={j === 0 ? 'true' : 'false'}>{x.label}</button>
              ))}
            </nav>
          </Player>
          <p class="actions">
            <a class="btn" id="dl-video" href={t.video} target="_blank" rel="noopener">Download video</a>
            <a class="btn" id="dl-audio" href={file(t.audio)} download={`${piece.slug}-${t.key}.mp3`}>Download audio</a>
          </p>
          </div>
        </section>
      )}
      {!synced && t.video && (
        <section class="box">
          <h2><span>Video</span><button type="button" class="min" aria-label="Minimize Video" aria-expanded="true"></button></h2>
          <div class="body">
          <Player kind="video" src={t.video} />
          <p class="actions">
            <a class="btn" href={t.video} target="_blank" rel="noopener">Download video</a>
          </p>
          </div>
        </section>
      )}
      </div>
      {t.pdf && (
        <section class="box score">
          <h2><span>Score PDF</span><button type="button" class="min" aria-label="Minimize Score PDF" aria-expanded="true"></button></h2>
          <div class="body">
          <div class="pdfview" data-src={file(t.pdf)}>
            <div class="bar">
              <button type="button" data-act="prev" aria-label="Previous page">◄</button>
              <button type="button" data-act="next" aria-label="Next page">►</button>
              <span class="pg">Page – / –</span>
              <button type="button" data-act="out" aria-label="Zoom out">–</button>
              <button type="button" data-act="in" aria-label="Zoom in">+</button>
              <button type="button" data-act="fit">Fit</button>
              <button type="button" class="fs" data-act="fs" aria-label="Fullscreen"></button>
            </div>
            <div class="pages" tabindex="0" aria-label={`${t.label} score`}></div>
            <p class="fallback">Can't see the score? Use the buttons below to open or download it.</p>
          </div>
          <p class="actions">
            <a class="btn" href={file(t.pdf)} target="_blank" rel="noopener">Open in new tab</a>
            <a class="btn" href={file(t.pdf)} download>Download PDF</a>
          </p>
          </div>
        </section>
      )}
    </section>
  ))}
</Layout>
<script>
  import '../../scripts/pdfview.js';
  document.addEventListener('click', (e) => {
    const b = e.target.closest?.('.min');
    if (!b) return;
    const body = b.closest('.box').querySelector('.body');
    body.hidden = !body.hidden;
    b.setAttribute('aria-expanded', String(!body.hidden));
  });
  const fmt = (s) => {
    if (!isFinite(s)) s = 0;
    return `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
  };
  document.querySelectorAll('.player').forEach((p) => {
    const m = p.querySelector('audio, video');
    const pp = p.querySelector('.pp');
    const seek = p.querySelector('.seek');
    const time = p.querySelector('.time');
    let dragging = false;
    const paint = () => {
      if (!dragging) seek.value = m.duration ? (m.currentTime / m.duration) * 1000 : 0;
      seek.style.setProperty('--p', `${seek.value / 10}%`);
      time.textContent = `${fmt(dragging ? (seek.value / 1000) * m.duration : m.currentTime)} / ${fmt(m.duration)}`;
    };
    const state = () => {
      const playing = !m.paused;
      pp.dataset.state = playing ? 'playing' : 'paused';
      pp.setAttribute('aria-label', playing ? 'Pause' : 'Play');
    };
    const toggle = () => (m.paused ? m.play().catch(() => {}) : m.pause());
    pp.addEventListener('click', toggle);
    if (m.tagName === 'VIDEO') m.addEventListener('click', toggle);
    p.querySelector('.fs')?.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else if (p.requestFullscreen) p.requestFullscreen().catch(() => {});
      else m.webkitEnterFullscreen?.();
    });
    seek.addEventListener('input', () => {
      dragging = true;
      if (m.duration) m.currentTime = (seek.value / 1000) * m.duration;
      paint();
    });
    seek.addEventListener('change', () => { dragging = false; paint(); });
    ['timeupdate', 'loadedmetadata', 'durationchange', 'seeked'].forEach((e) => m.addEventListener(e, paint));
    ['play', 'pause', 'ended'].forEach((e) => m.addEventListener(e, state));
  });
  // Desktop mode: the score fills the window height, the video column matches it,
  // and the body is as wide as that needs. If it won't fit the width, fall back to one column.
  const root = document.documentElement;
  let lastPh = 0;
  const fit = () => {
    const c = document.querySelector('.cols:not([hidden])');
    if (!c) return;
    const v = c.querySelector('.video');
    const score = c.querySelector('.score');
    const pages = c.querySelector('.pages');
    const media = c.querySelector('.media');
    const mobile = () => {
      root.classList.remove('desk');
      document.querySelectorAll('.video').forEach((e) => { e.style.height = ''; });
    };
    if (!score) return mobile();
    root.classList.add('desk');
    document.querySelectorAll('.box > .body').forEach((e) => { e.hidden = false; });
    document.querySelectorAll('.min').forEach((e) => e.setAttribute('aria-expanded', 'true'));
    document.querySelectorAll('.video').forEach((e) => { e.style.height = ''; });
    if (v) v.style.height = '240px';
    let ph = lastPh;
    if (pages.offsetHeight) {
      root.style.setProperty('--ph', '480px');
      const total = document.body.getBoundingClientRect().bottom + scrollY + 12;
      ph = Math.floor(innerHeight - (total - pages.offsetHeight));
      lastPh = ph;
    }
    if (ph < 380) return mobile();
    const apply = () => {
      root.style.setProperty('--ph', `${ph}px`);
      let h = '';
      if (v && pages.offsetHeight) {
        const other = media.offsetHeight - v.offsetHeight;
        const cs = getComputedStyle(score);
        const outer = score.offsetHeight + parseFloat(cs.marginTop) + parseFloat(cs.marginBottom);
        h = `${Math.max(200, outer - other)}px`;
      }
      document.querySelectorAll('.video').forEach((e) => { e.style.height = h; });
    };
    apply();
    const excess = root.scrollHeight - innerHeight;
    if (excess > 0 && pages.offsetHeight) {
      ph -= excess;
      lastPh = ph;
      if (ph < 380) return mobile();
      apply();
    }
    const need = media.getBoundingClientRect().width + 16 + score.getBoundingClientRect().width + 18;
    if (need > innerWidth - 24) mobile();
  };
  addEventListener('resize', fit);
  const reveal = () => root.classList.remove('pre');
  addEventListener('refit', () => { fit(); reveal(); });
  fit();
  if (!document.querySelector('.score')) reveal();
  else setTimeout(reveal, 2500);
  const tabs = document.querySelectorAll('[data-tab]');
  const panels = document.querySelectorAll('[data-panel]');
  // Audio syncs with audio and video with video, never across kinds.
  const media = (p, kind) => p?.querySelector(kind);
  const handOff = (from, to) => {
    if (!from || !to) return;
    const t = from.currentTime;
    const play = !from.paused;
    from.pause();
    const go = () => {
      to.currentTime = t;
      if (play) to.play().catch(() => {});
    };
    if (to.readyState >= 1) go();
    else {
      to.addEventListener('loadedmetadata', go, { once: true });
      to.load();
    }
  };
  // Every tab shows the same score, so keep one viewer and move it into the visible panel.
  const score = document.querySelector('.score');
  document.querySelectorAll('.score').forEach((e) => { if (e !== score) e.remove(); });
  // Synced mode: one muted video drives silent-until-selected MP3s, so switching tabs
  // only changes which one is unmuted (no seeking, no reloading).
  const synced = document.querySelector('nav.tabs[data-synced]');
  const aud = {};
  let setActive;
  const dlVideo = document.getElementById('dl-video');
  const dlAudio = document.getElementById('dl-audio');
  if (synced) {
    const v = document.querySelector('.player video');
    v.muted = true;
    tabs.forEach((t) => {
      if (!t.dataset.audio) return;
      const a = new Audio();
      a.preload = 'auto';
      a.src = t.dataset.audio;
      aud[t.dataset.tab] = a;
    });
    // Crossfade between parts with Web Audio gain ramps (smoother than ramping element volume,
    // and it also works on iOS). Without Web Audio, fall back to a hard mute.
    let active = tabs[0].dataset.tab;
    let ctx = null;
    const gains = {};
    const TAU = 0.04;
    const graph = () => {
      if (ctx || !window.AudioContext) return;
      ctx = new AudioContext();
      Object.entries(aud).forEach(([k, a]) => {
        const g = ctx.createGain();
        a.muted = false;
        g.gain.value = k === active ? 1 : 0;
        ctx.createMediaElementSource(a).connect(g).connect(ctx.destination);
        gains[k] = g;
      });
    };
    const levels = () => {
      Object.entries(aud).forEach(([k, a]) => {
        const on = k === active;
        if (!ctx) { a.muted = !on; return; }
        gains[k].gain.cancelScheduledValues(ctx.currentTime);
        gains[k].gain.setTargetAtTime(on ? 1 : 0, ctx.currentTime, TAU);
      });
    };
    setActive = (key) => { active = key; levels(); };
    levels();
    v.addEventListener('play', () => { graph(); ctx?.resume(); }, { capture: true });
    const all = () => Object.values(aud);
    // Seeking the audible part makes a click, so it gets a looser tolerance than the silent ones.
    const off = (k, a) => Math.abs(a.currentTime - v.currentTime) > (k === active ? 0.25 : 0.03);
    const resume = () => Object.entries(aud).forEach(([k, a]) => {
      if (off(k, a)) a.currentTime = v.currentTime;
      if (a.paused) a.play().catch(() => {});
    });
    v.addEventListener('play', resume);
    v.addEventListener('playing', resume);
    ['pause', 'waiting', 'ended'].forEach((e) => v.addEventListener(e, () => all().forEach((a) => a.pause())));
    v.addEventListener('seeked', () => all().forEach((a) => { a.currentTime = v.currentTime; }));
    setInterval(() => {
      if (v.paused || v.seeking) return;
      Object.entries(aud).forEach(([k, a]) => { if (off(k, a)) a.currentTime = v.currentTime; });
    }, 500);
  }
  tabs.forEach((tab) => tab.addEventListener('click', () => {
    if (synced) {
      tabs.forEach((x) => x.setAttribute('aria-selected', String(x === tab)));
      setActive(tab.dataset.tab);
      dlVideo.hidden = !tab.dataset.video;
      if (tab.dataset.video) dlVideo.href = tab.dataset.video;
      dlAudio.hidden = !tab.dataset.audio;
      if (tab.dataset.audio) { dlAudio.href = tab.dataset.audio; dlAudio.download = tab.dataset.name; }
      return;
    }
    const prev = [...panels].find((p) => !p.hidden);
    const next = [...panels].find((p) => p.dataset.panel === tab.dataset.tab);
    if (!next || prev === next) return;
    tabs.forEach((x) => x.setAttribute('aria-selected', String(x === tab)));
    const sc = score?.querySelector('.pages');
    const left = sc ? sc.scrollLeft : 0;
    panels.forEach((p) => { p.hidden = p !== next; });
    if (score) {
      next.append(score);
      sc.scrollLeft = left;
    }
    ['audio', 'video'].forEach((k) => handOff(media(prev, k), media(next, k)));
  }));
</script>

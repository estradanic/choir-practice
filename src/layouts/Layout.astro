---
const { title } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style is:global>
      :root { --face: #d4d0c8; --hi: #fff; --mid: #808080; --dark: #404040; --navy: #0a246a; --raised: inset -1px -1px var(--dark), inset 1px 1px var(--hi), inset -2px -2px var(--mid), inset 2px 2px var(--face); --sunken: inset 1px 1px var(--mid), inset -1px -1px var(--hi), inset 2px 2px var(--dark), inset -2px -2px var(--face); }
      html { background: #5f9fc9; padding: 0 12px; min-height: 100%; }
      body { font: 13px/1.45 Tahoma, Verdana, "Segoe UI", Arial, sans-serif; max-width: 44rem; margin: 12px auto; padding: 2px 8px 8px; background: var(--face); color: #000; box-shadow: var(--raised), 2px 2px 0 #000; }
      @media (min-width: 600px) { body { font-size: 14px; } }
      h1 { margin: 2px -6px 8px; padding: 4px 8px; font-size: 1.1rem; color: #fff; background: linear-gradient(90deg, var(--navy), #a6caf0); }
      .titlebar { display: flex; align-items: center; gap: 8px; margin: 2px -6px 8px; padding: 2px 4px 2px 8px; background: linear-gradient(90deg, var(--navy), #a6caf0); }
      .titlebar h1 { flex: 1; margin: 0; padding: 0; background: none; min-width: 0; }
      .titlebar .btn { padding: 1px 8px; font-size: 12px; white-space: nowrap; }
      h2 { font-size: 1rem; margin: 12px 0 4px; }
      a { color: #0000ee; }
      small { color: #333; }
      button, .btn { font: inherit; color: #000; background: var(--face); border: 0; padding: 5px 14px; box-shadow: var(--raised); cursor: pointer; text-decoration: none; display: inline-block; }
      button:active, .btn:active { box-shadow: var(--sunken); padding: 6px 13px 4px 15px; }
      button:focus-visible, .btn:focus-visible { outline: 1px dotted #000; outline-offset: -4px; }
      nav.tabs { display: flex; flex-wrap: wrap; gap: 4px; margin: 8px 0; }
      nav.tabs button[aria-selected=true] { box-shadow: var(--sunken); font-weight: bold; background: #e8e6e0; }
      input[type=search] { font: inherit; background: #fff; border: 0; box-shadow: var(--sunken); padding: 5px 6px; }
      audio { width: 100%; display: block; }
      .video { display: block; width: 100%; max-width: 480px; margin: 0 auto; aspect-ratio: 832/1078; background: #000; box-shadow: var(--sunken); }
      .box { margin: 12px 0; padding: 2px 8px 8px; box-shadow: var(--raised); background: var(--face); }
      .box > h2 { display: flex; align-items: center; justify-content: space-between; margin: 0 -6px 8px; padding: 3px 8px; font-size: 1rem; color: #fff; background: linear-gradient(90deg, var(--navy), #a6caf0); }
      .actions { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; margin-bottom: 0; padding-top: 8px; border-top: 1px solid var(--mid); box-shadow: 0 1px 0 var(--hi) inset; }
      .min { position: relative; padding: 0; width: 22px; height: 20px; flex: none; }
      .min::before { content: ""; position: absolute; box-sizing: border-box; background: #000; }
      .min[aria-expanded=true]::before { left: 6px; bottom: 5px; width: 8px; height: 3px; }
      .min[aria-expanded=false]::before { left: 6px; top: 5px; width: 9px; height: 8px; background: none; border: 1px solid #000; border-top-width: 2px; }
      [hidden] { display: none !important; }
      object.pdf { width: 100%; height: 75vh; box-shadow: var(--sunken); background: #fff; margin: 6px 0; }
      ul.list { list-style: none; padding: 0; margin: 0; background: #fff; box-shadow: var(--sunken); }
      ul.list li { padding: 6px 8px; border-bottom: 1px dotted var(--mid); }
      ul.list a { font-size: 1.05rem; }
      [hidden] { display: none !important; }
    </style>
  </head>
  <body><slot /></body>
</html>

---
const { title, wide } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style is:global>
      :root { --face: #d4d0c8; --hi: #fff; --mid: #808080; --dark: #404040; --navy: #0a246a; --raised: inset -1px -1px var(--dark), inset 1px 1px var(--hi), inset -2px -2px var(--mid), inset 2px 2px var(--face); --sunken: inset 1px 1px var(--mid), inset -1px -1px var(--hi), inset 2px 2px var(--dark), inset -2px -2px var(--face); }
      html { background: #5f9fc9; padding: 0 12px; min-height: 100%; }
      body { font: 13px/1.45 Tahoma, Verdana, "Segoe UI", Arial, sans-serif; max-width: 44rem; margin: 12px auto; padding: 2px 8px 8px; background: var(--face); color: #000; box-shadow: var(--raised), 2px 2px 0 #000; }
      @media (min-width: 600px) { body { font-size: 14px; } }
      h1 { margin: 2px -6px 8px; padding: 4px 8px; font-size: 1.1rem; color: #fff; background: linear-gradient(90deg, var(--navy), #a6caf0); }
      .titlebar { display: flex; align-items: center; gap: 8px; margin: 2px -6px 8px; padding: 2px 4px 2px 8px; background: linear-gradient(90deg, var(--navy), #a6caf0); }
      .titlebar h1 { flex: 1; margin: 0; padding: 0; background: none; min-width: 0; }
      .titlebar .btn { padding: 1px 8px; font-size: 12px; white-space: nowrap; }
      h2 { font-size: 1rem; margin: 12px 0 4px; }
      a { color: #0000ee; }
      small { color: #333; }
      button, .btn { font: inherit; color: #000; background: var(--face); border: 0; padding: 5px 14px; box-shadow: var(--raised); cursor: pointer; text-decoration: none; display: inline-block; }
      button:active, .btn:active { box-shadow: var(--sunken); padding: 6px 13px 4px 15px; }
      button:focus-visible, .btn:focus-visible { outline: 1px dotted #000; outline-offset: -4px; }
      nav.tabs { display: flex; flex-wrap: wrap; gap: 4px; margin: 8px 0; }
      nav.tabs button[aria-selected=true] { box-shadow: var(--sunken); font-weight: bold; background: #e8e6e0; }
      input[type=search] { font: inherit; background: #fff; border: 0; box-shadow: var(--sunken); padding: 5px 6px; }
      .controls { display: flex; align-items: center; gap: 8px; margin-top: 6px; }
      .controls:first-child { margin-top: 0; }
      .pp { position: relative; flex: none; width: 34px; height: 26px; padding: 0; }
      .pp::before { content: ""; position: absolute; left: 50%; top: 50%; background: #000; transform: translate(-50%, -50%); }
      .pp[data-state=paused]::before { width: 10px; height: 12px; clip-path: polygon(0 0, 100% 50%, 0 100%); margin-left: 1px; }
      .pp[data-state=playing]::before { width: 10px; height: 12px; background: linear-gradient(90deg, #000 0 3px, transparent 3px 7px, #000 7px); }
      .pp:active, .min:active { padding: 0; }
      .pp:active::before { margin-top: 1px; margin-left: 2px; }
      .time { flex: none; font-variant-numeric: tabular-nums; padding: 3px 6px; background: #fff; box-shadow: var(--sunken); font-size: 0.9rem; }
      .seek { flex: 1; min-width: 0; height: 22px; margin: 0; background: transparent; -webkit-appearance: none; appearance: none; cursor: pointer; }
      .seek::-webkit-slider-runnable-track { height: 4px; background: linear-gradient(90deg, var(--navy) var(--p, 0%), #fff var(--p, 0%)); box-shadow: var(--sunken); }
      .seek::-moz-range-track { height: 4px; background: #fff; box-shadow: var(--sunken); }
      .seek::-webkit-slider-thumb { -webkit-appearance: none; width: 11px; height: 20px; margin-top: -8px; background: var(--face); border: 0; border-radius: 0; box-shadow: var(--raised); }
      .seek::-moz-range-progress { height: 4px; background: var(--navy); }
      .seek::-moz-range-thumb { width: 11px; height: 20px; background: var(--face); border: 0; border-radius: 0; box-shadow: var(--raised); }
      .seek:focus-visible { outline: 1px dotted #000; }
      @media (max-width: 420px) { .time { font-size: 0.8rem; padding: 3px 4px; } }
      .video { display: block; width: 100%; max-width: 480px; margin: 0 auto; aspect-ratio: 832/1078; background: #000; box-shadow: var(--sunken); }
      .box { margin: 12px 0; padding: 2px 8px 8px; box-shadow: var(--raised); background: var(--face); }
      .box > h2 { display: flex; align-items: center; justify-content: space-between; margin: 0 -6px 8px; padding: 3px 8px; font-size: 1rem; color: #fff; background: linear-gradient(90deg, var(--navy), #a6caf0); }
      .actions { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; margin-bottom: 0; padding-top: 8px; border-top: 1px solid var(--mid); box-shadow: 0 1px 0 var(--hi) inset; }
      .min { position: relative; padding: 0; width: 22px; height: 20px; flex: none; }
      .min::before { content: ""; position: absolute; box-sizing: border-box; background: #000; }
      .min[aria-expanded=true]::before { left: 6px; bottom: 5px; width: 8px; height: 3px; }
      .min[aria-expanded=false]::before { left: 6px; top: 5px; width: 9px; height: 8px; background: none; border: 1px solid #000; border-top-width: 2px; }
      html.desk body.wide { width: fit-content; max-width: calc(100vw - 24px); }
      html.desk .cols { --pa: 0.773; display: grid; grid-template-columns: auto auto; gap: 0 16px; align-items: start; justify-content: center; }
      html.desk .media { min-width: 22rem; }
      html.desk .media .video { width: auto; max-width: none; }
      html.desk .min { display: none; }
      html.desk .score { width: calc((var(--ph) - 16px) * var(--pa) + 32px); }
      html.desk .score .pages { height: var(--ph); }
      [hidden] { display: none !important; }
      .pdfview .bar { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; }
      .pdfview .bar button { padding: 3px 0; min-width: 30px; }
      .pdfview .bar button:active { padding: 4px 0 2px; }
      button:disabled { color: var(--mid); text-shadow: 1px 1px 0 var(--hi); cursor: default; }
      button:disabled:active { box-shadow: var(--raised); padding: 5px 14px; }
      .pdfview .bar button:disabled:active { padding: 3px 0; }
      .pdfview .pg { flex: 1; text-align: center; padding: 3px 6px; background: #fff; box-shadow: var(--sunken); font-variant-numeric: tabular-nums; }
      .pdfview .pages { display: flex; gap: 8px; height: 75vh; overflow-x: auto; overflow-y: auto; padding: 8px; background: var(--mid); box-shadow: var(--sunken); scroll-snap-type: x proximity; scroll-padding: 8px; position: relative; }
      .pdfpage { flex: none; margin: auto 0; background: #fff; box-shadow: 1px 1px 0 var(--dark); scroll-snap-align: start; }
      .pdfpage canvas { display: block; width: 100%; height: 100%; }
      .pdfview .fallback { display: none; }
      .pdfview.failed .fallback { display: block; }
      ul.list { list-style: none; padding: 0; margin: 0; background: #fff; box-shadow: var(--sunken); }
      ul.list li { padding: 6px 8px; border-bottom: 1px dotted var(--mid); }
      ul.list a { font-size: 1.05rem; }
      [hidden] { display: none !important; }
    </style>
  </head>
  <body class={wide ? 'wide' : undefined}><slot /></body>
</html>
